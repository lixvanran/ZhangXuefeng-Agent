# ===== LLM (Chat) - OpenRouter (单一 Key 跑所有模型) =====
# OpenRouter 是 LLM 路由平台，一把 Key 调 Claude/GLM/DeepSeek/Qwen 等
# 注册: https://openrouter.ai/
LLM_API_KEY=sk-or-v1-xxxxxxxx
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=anthropic/claude-opus-4.6

# Auto-fallback models (v0.7.5)
# 主力挂了自动切下一个，质量优先
LLM_FALLBACK_MODELS=anthropic/claude-sonnet-4.6,z-ai/glm-5,z-ai/glm-5.2,deepseek/deepseek-v3.2,minimax/minimax-m3,qwen/qwen-2.5-72b-instruct

# ===== OpenRouter Headers =====
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_TITLE=ZhangXueFeng-Agent

# ===== Embedding (RAG 用) =====
# Strategy: if OPENAI_API_KEY is set, use OpenAI; else use local (auto-download)
# Fill in your OpenAI key here to use OpenAI embedding (faster, better)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ===== Tavily Web Search (optional, 1000 free/month) =====
# Get free key: https://tavily.com
# If empty, falls back to DuckDuckGo (free, no key)
TAVILY_API_KEY=

# ===== Web Search =====
# v0.7.5: 默认开启（用户用 KB 为主，联网为辅）
WEB_SEARCH_ENABLED=true

# ===== Deep Thinking (v0.7.5) =====
DEEP_THINKING_MODEL=z-ai/glm-5.2
DEEP_THINKING_FALLBACK_MODELS=anthropic/claude-sonnet-4.6,z-ai/glm-5,deepseek/deepseek-r1

# ===== Vision (v0.7.5) =====
VISION_MODEL=anthropic/claude-sonnet-4.6

# ===== HuggingFace Mirror (for local embedding model) =====
# Default uses China mirror for faster download
HF_ENDPOINT=https://hf-mirror.com

# ===== Voice Cloning (optional) =====
# To clone Zhang's voice, place 30s-2min audio at samples/zhangxuefeng.mp3
# Then run: python scripts/clone_zhang_voice.py
# It will write ZHANG_VOICE_ID here automatically
ZHANG_VOICE_ID=

# ===== v0.7.5: Model Tier Routing =====
# 复杂度分类: 轻量模型先判断问题复杂度, 再选主模型
# - low    (闲聊/简单):  国产便宜
# - medium (标准问答):  Claude Sonnet
# - high   (复杂规划):  Claude Opus 旗舰
TIER_CLASSIFY_MODEL=minimax/minimax-m3
TIER_MODEL_LOW=minimax/minimax-m3
TIER_FALLBACK_LOW=minimax/minimax-m2,deepseek/deepseek-chat,qwen/qwen-2.5-72b-instruct
TIER_MODEL_MEDIUM=anthropic/claude-sonnet-4.6
TIER_FALLBACK_MEDIUM=z-ai/glm-5,minimax/minimax-m3,deepseek/deepseek-chat
TIER_MODEL_HIGH=anthropic/claude-opus-5
TIER_FALLBACK_HIGH=anthropic/claude-sonnet-4.6,z-ai/glm-5.2,z-ai/glm-5
