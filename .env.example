# ⚠️ v0.10.0: 本文件是**历史遗留模板**, 默认值已过时, 建议直接用 backend/.env.example。
#    config.py 的加载顺序是: 先读根目录 .env, 再读 backend/.env, 且 override=True
#    → 同名变量 backend/.env 胜出, 也就是 **backend/.env.example 才是权威模板**。
#    两份内容不一致时以 backend/.env.example 为准(本文件的 TIER_* 段尤其过时)。
# ===== LLM (Chat) - OpenRouter (一把 Key 调所有模型) =====
# 注册: https://openrouter.ai/
LLM_API_KEY=sk-or-v1-xxxxxxxx
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen-2.5-72b-instruct

# Auto-fallback models (实际可用, OpenRouter 上都存在)
LLM_FALLBACK_MODELS=deepseek/deepseek-chat,qwen/qwen-2.5-7b-instruct,google/gemini-2.0-flash-001

# ===== OpenRouter Headers =====
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_TITLE=ZhangXueFeng-Agent

# ===== Embedding =====
# 留空 → 走本地 TF-IDF 假 embedding (无依赖, 不够好但能跑)
# 填了 → 调 OpenAI text-embedding-3-small (更准, 需科学上网)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ===== Tavily Web Search (optional, 1000 free/month) =====
TAVILY_API_KEY=

# ===== Web Search =====
WEB_SEARCH_ENABLED=true

# ===== Deep Thinking =====
DEEP_THINKING_MODEL=deepseek/deepseek-r1
DEEP_THINKING_FALLBACK_MODELS=deepseek/deepseek-chat,qwen/qwen-2.5-72b-instruct
DEEP_THINKING_EFFORT=medium

# ===== Vision =====
VISION_MODEL=openai/gpt-4o-mini
VISION_FALLBACK_MODELS=google/gemini-2.0-flash-001,qwen/qwen-2.5-vl-72b-instruct

# ===== TTS (MiniMax) =====
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_VOICE_DEFAULT=male-qn-qingse

# ===== Voice Cloning (optional) =====
ZHANG_VOICE_ID=

# ===== HuggingFace Mirror =====
HF_ENDPOINT=https://hf-mirror.com

# ===== Model Tier Routing =====
# LOW 档: 闲聊 / 简单查询
# ⚠️ v0.10.0: TIER_MODEL_* / TIER_FALLBACK_* 已废弃, 改这里没有任何效果。
#    实际生效: 前端"系统设置"页 → user_preferences 表 → model_whitelist.DEFAULT_TIER_MODELS 兜底。
#    下面是历史遗留项, 留着只为不打断旧 .env 的解析, 不会被读取。

# MEDIUM 档: 标准问答

# HIGH 档: 复杂规划/推理

# 分类用模型
TIER_CLASSIFY_MODEL=qwen/qwen-2.5-7b-instruct

# 复杂度分类专用 — 用 minimaxM3 评估问题复杂度
# 默认: minimax/minimax-m3 (你账号里如果叫别的, 改这里)
CLASSIFY_MODEL=minimax/minimax-m3
